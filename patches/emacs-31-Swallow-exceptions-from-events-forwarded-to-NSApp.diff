From 041155991cbb146eb009555f55a73ceffcbffcb3 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Przemys=C5=82aw=20Kryger?= <pkryger@gmail.com>
Date: Tue, 27 Jan 2026 15:50:43 +0000
Subject: [PATCH] Swallow exceptions from events forwarded to NSApp

* src/macappkit.m: ([EmacsController handleOneNSEvent:]):
Add try/catch block.
---
 src/macappkit.m | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/macappkit.m b/src/macappkit.m
index f2fc6791922..40d3e296d51 100644
--- a/src/macappkit.m
+++ b/src/macappkit.m
@@ -1602,7 +1602,12 @@ - (void)handleOneNSEvent:(NSEvent *)event
 		}
 	    }
 	}
-      [NSApp sendEvent:event];
+      @try
+	{
+	  [NSApp sendEvent:event];
+	}
+      @catch (NSException *exception)
+	{}
       break;
     }
 
